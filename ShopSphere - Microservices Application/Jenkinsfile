pipeline {
    agent any

    environment {
        REGISTRY       = 'docker.io/shopsphere'
        IMAGE_TAG      = "${env.BUILD_NUMBER}"
        DOCKER_CREDS   = credentials('dockerhub-creds')
        GIT_CREDS      = credentials('github-creds')
        KUBECONFIG     = credentials('kubeconfig')
    }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 45, unit: 'MINUTES')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'git rev-parse --short HEAD > .git-sha'
            }
        }

        stage('Install Dependencies') {
            parallel {
                stage('api-gateway')   { steps { dir('api-gateway')   { sh 'npm ci' } } }
                stage('auth-service')  { steps { dir('auth-service')  { sh 'npm ci' } } }
                stage('user-service')  { steps { dir('user-service')  { sh 'npm ci' } } }
                stage('order-service') { steps { dir('order-service') { sh 'npm ci' } } }
                stage('frontend')      { steps { dir('frontend')      { sh 'npm ci' } } }
            }
        }

        stage('Lint & Test') {
            parallel {
                stage('api-gateway')   { steps { dir('api-gateway')   { sh 'npm test --if-present' } } }
                stage('auth-service')  { steps { dir('auth-service')  { sh 'npm test --if-present' } } }
                stage('user-service')  { steps { dir('user-service')  { sh 'npm test --if-present' } } }
                stage('order-service') { steps { dir('order-service') { sh 'npm test --if-present' } } }
                stage('frontend')      { steps { dir('frontend')      { sh 'npm test --if-present -- --watchAll=false' } } }
            }
        }

        stage('Build Docker Images') {
            steps {
                script {
                    def services = ['api-gateway', 'auth-service', 'user-service', 'order-service', 'frontend']
                    for (svc in services) {
                        sh """
                            docker build -t ${REGISTRY}/${svc}:${IMAGE_TAG} \
                                         -t ${REGISTRY}/${svc}:latest \
                                         ./${svc}
                        """
                    }
                }
            }
        }

        stage('Push Images') {
            steps {
                sh "echo \$DOCKER_CREDS_PSW | docker login -u \$DOCKER_CREDS_USR --password-stdin"
                script {
                    def services = ['api-gateway', 'auth-service', 'user-service', 'order-service', 'frontend']
                    for (svc in services) {
                        sh "docker push ${REGISTRY}/${svc}:${IMAGE_TAG}"
                        sh "docker push ${REGISTRY}/${svc}:latest"
                    }
                }
            }
        }

        stage('Update K8s Manifests') {
            steps {
                sh """
                    for svc in api-gateway auth-service user-service order-service frontend; do
                        sed -i "s|image: .*shopsphere/\${svc}:.*|image: ${REGISTRY}/\${svc}:${IMAGE_TAG}|g" k8s/\${svc}/deployment.yaml || true
                    done
                """
                sh 'git config user.email "jenkins@shopsphere.com"'
                sh 'git config user.name "Jenkins CI"'
                sh 'git add k8s/'
                sh 'git commit -m "chore: bump images to ${IMAGE_TAG} [skip ci]" || true'
                withCredentials([usernamePassword(credentialsId: 'github-creds', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_TOKEN')]) {
                    sh "git push https://\${GIT_USER}:\${GIT_TOKEN}@github.com/your-org/shopsphere.git HEAD:main || true"
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                sh 'kubectl get pods -n shopsphere'
                sh 'kubectl rollout status deployment -n shopsphere --timeout=180s || true'
            }
        }
    }

    post {
        success {
            echo '✅ ShopSphere pipeline succeeded.'
        }
        failure {
            echo '❌ ShopSphere pipeline failed.'
        }
        always {
            sh 'docker logout || true'
            cleanWs()
        }
    }
}
