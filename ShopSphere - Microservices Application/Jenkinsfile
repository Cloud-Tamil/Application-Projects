pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    environment {
        APP_DIR = 'ShopSphere - Microservices Application'
        AWS_REGION = "${env.AWS_REGION ?: 'us-east-1'}"
        IMAGE_PREFIX = 'shopsphere'
        TAG = "build-${env.BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    if (env.GIT_COMMIT) {
                        env.TAG = env.GIT_COMMIT.take(12)
                    }
                }
                sh 'git status --short --branch'
                sh 'test -f "$APP_DIR/Jenkinsfile"'
            }
        }

        stage('Validate Source') {
            parallel {
                stage('Node syntax') {
                    steps {
                        sh '''
                            set -e
                            for service in auth-service user-service order-service api-gateway; do
                              find "$APP_DIR/$service/src" -name '*.js' -print0 | xargs -0 -n1 node --check
                            done
                        '''
                    }
                }
                stage('Frontend build') {
                    steps {
                        dir("${APP_DIR}/frontend") {
                            sh 'npm install --no-audit --no-fund'
                            sh 'npm run build'
                        }
                    }
                }
            }
        }

        stage('Trivy Filesystem Scan') {
            steps {
                sh '''
                    docker run --rm \
                      -v "$WORKSPACE:/work" \
                      aquasec/trivy:0.67.2 fs \
                      --scanners vuln,secret \
                      --severity HIGH,CRITICAL \
                      --exit-code 1 \
                      "/work/$APP_DIR"
                '''
            }
        }

        stage('AWS / ECR Login') {
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-jenkins-creds']]) {
                    script {
                        env.AWS_ACCOUNT_ID = sh(
                            script: 'aws sts get-caller-identity --query Account --output text',
                            returnStdout: true
                        ).trim()
                        env.ECR_REGISTRY = "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com"
                    }
                    sh 'aws ecr get-login-password --region "$AWS_REGION" | docker login --username AWS --password-stdin "$ECR_REGISTRY"'
                }
            }
        }

        stage('Build Images') {
            steps {
                sh '''
                    set -e
                    for service in auth-service user-service order-service api-gateway frontend; do
                      docker build --pull -t "$ECR_REGISTRY/$IMAGE_PREFIX/$service:$TAG" "$APP_DIR/$service"
                    done
                '''
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                    set -e
                    for image in auth-service user-service order-service api-gateway frontend; do
                      docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \
                        aquasec/trivy:0.67.2 image \
                        --severity HIGH,CRITICAL \
                        --exit-code 1 \
                        "$ECR_REGISTRY/$IMAGE_PREFIX/$image:$TAG"
                    done
                '''
            }
        }

        stage('Push Images') {
            steps {
                sh '''
                    set -e
                    for image in auth-service user-service order-service api-gateway frontend; do
                      docker push "$ECR_REGISTRY/$IMAGE_PREFIX/$image:$TAG"
                    done
                '''
            }
        }

        stage('Update GitOps Manifests') {
            when { branch 'main' }
            steps {
                sh '''
                    set -e
                    for service in auth-service user-service order-service api-gateway frontend; do
                      sed -i "s|^[[:space:]]*image:.*|          image: ${ECR_REGISTRY}/${IMAGE_PREFIX}/${service}:${TAG}|" \
                        "$APP_DIR/k8s/${service}/deployment.yaml"
                    done
                    grep -R "image:" "$APP_DIR/k8s"/*/deployment.yaml
                '''
            }
        }

        stage('Commit GitOps Changes') {
            when { branch 'main' }
            steps {
                withCredentials([usernamePassword(credentialsId: 'github-token', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_TOKEN')]) {
                    sh '''
                        set -e
                        git config user.name "Jenkins"
                        git config user.email "jenkins@local"
                        git add "$APP_DIR/k8s"
                        if git diff --cached --quiet; then
                          echo "No manifest changes to commit"
                        else
                          git commit -m "ci: deploy ShopSphere ${TAG} [skip ci]"
                          git push "https://${GIT_USER}:${GIT_TOKEN}@github.com/Cloud-Tamil/Application-Projects.git" HEAD:main
                        fi
                    '''
                }
            }
        }

        stage('GitOps Handoff') {
            when { branch 'main' }
            steps {
                echo 'Argo CD watches the k8s directory and will reconcile the new image tags.'
            }
        }
    }

    post {
        always {
            sh 'docker logout "$ECR_REGISTRY" || true'
        }
        success { echo "ShopSphere CI/CD completed successfully: ${TAG}" }
        failure { echo "ShopSphere CI/CD failed: ${TAG}" }
    }
}
